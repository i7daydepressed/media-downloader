{
  "Media": {
    "MaxUrlsPerBatch": 10,
    "MaxFilesPerUrl": 100,
    "MaxConcurrentOperations": 1,
    "WorkingRoot": "data/work",
    "MaxFileSizeBytes": 2000000000,
    "AllowLocalUrls": false
  },
  "Tools": {
    "YtDlpPath": "yt-dlp",
    "GalleryDlPath": "gallery-dl",
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "JavaScriptRuntime": "deno",
    "JavaScriptRuntimePath": "deno",
    "ProcessTimeoutSeconds": 600,
    "MaxCapturedOutputCharacters": 65536
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "AllowedUserIds": [],
    "BaseUrl": "https://api.telegram.org",
    "UseLocalBotApi": false,
    "MaxUploadSizeBytes": 50000000,
    "QueueCapacity": 20,
    "PollingTimeoutSeconds": 30,
    "RetryDelaySeconds": 3,
    "UploadTimeoutSeconds": 1800
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
