# Copy to .env for Docker Compose. Real .env values must stay outside Git.
# .NET configuration uses a double underscore between section/key/index.
Telegram__Enabled=false
Telegram__BotToken=
Telegram__BaseUrl=https://api.telegram.org
Telegram__UseLocalBotApi=false
Telegram__MaxUploadSizeBytes=50000000
# Persistent TXT: UTC date, tab, URL. Keep this path inside the history volume.
# Telegram__LinksHistoryPath=/app/data/history/telegram-links.txt
# Upload deadline in seconds for long Telegram multipart sends:
# Telegram__UploadTimeoutSeconds=1800

# When enabling Telegram, uncomment and replace YOUR_NUMERIC_USER_ID with your
# positive numeric user ID. Add indices 1, 2, ... for more users. Never leave an
# uncommented index empty, and do not use a JSON array in Telegram__AllowedUserIds.
# Telegram__AllowedUserIds__0=YOUR_NUMERIC_USER_ID

# Local Bot API is optional: docker compose --profile telegram-local up -d --build
# Before migrating a bot, perform Telegram's required logOut on the old server.
# Then enable Telegram above, supply your token/whitelist, and set:
# Telegram__BaseUrl=http://telegram-bot-api:8081
# Telegram__UseLocalBotApi=true
# Telegram__MaxUploadSizeBytes=2000000000
# Supply your own API credentials only when using the telegram-local profile.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The local Bot API keeps a separate named telegram-data volume. App cleanup
# does not clear it. docker compose down retains it; do not remove it routinely.
# dotnet run does not read .env; pass configuration in the process environment.
